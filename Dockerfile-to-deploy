# syntax=docker/dockerfile:experimental
# Light layer built on every code change: starts from the cached base image
# (deps + Chromium already installed) and just copies the source.
ARG APP_BASE_IMAGE
FROM $APP_BASE_IMAGE

WORKDIR /auto_tester

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY . .

# Default behavior is the long-lived GUI service. The CronJob/Job overrides
# `command` to run the full suite and exit (see helm_chart/values_integration.yaml).
EXPOSE 8080
ENTRYPOINT ["python", "main.py"]
CMD ["gui", "--host", "0.0.0.0", "--port", "8080"]
