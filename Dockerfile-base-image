# Heavy, cached layer. Rebuilt only when BASE_IMAGE_FILES change (see jenkins-variables.yml).
# Base on the official Playwright Python image so Chromium + its system libs are preinstalled
# and the version matches playwright==1.40.0 in requirements.txt.
FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

# Create non-root vcita user matching vcita's container security standard.
# The Playwright base image already ships a "pwuser" owning uid/gid 1000, so we
# pin vcita to 1001 instead of the org-default 1000 to avoid the collision
# (groupadd would otherwise fail with "GID '1000' already exists"). Nothing
# downstream references the numeric id — only the "vcita" name — so 1001 is safe.
RUN groupadd -r -g 1001 vcita && useradd -m -s /bin/bash -r -u 1001 -g vcita vcita

WORKDIR /autotester
RUN chown vcita:vcita /autotester

# Keep Python from writing .pyc files and turn off output buffering for cleaner container logs.
# PIP_NO_INPUT + PIP_PROGRESS_BAR=off prevent pip from spawning a background refresh
# thread for its Rich progress bar — that thread creation fails under Jenkins build
# containers with a low pids.max/nproc limit ("can't start new thread", exit code 2).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INPUT=1 \
    PIP_PROGRESS_BAR=off

# Install Python dependencies first to leverage Docker layer caching.
COPY --chown=vcita:vcita requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --progress-bar off -r requirements.txt

# The runner launches the real Google Chrome channel (channel='chrome' in
# src/runner/runner.py and main.py), which is NOT bundled in the base image (it
# ships Chromium). Playwright's channel='chrome' only needs the system
# google-chrome binary on PATH, so we install it straight from Google's apt repo
# instead of `playwright install --with-deps chrome`. The Node-based installer
# spins up a V8/libuv thread pool that aborts (uv_thread_create, exit 134) under
# the Jenkins build host's low nproc limit; apt/dpkg don't, so this sidesteps it.
# Browser system libraries are already provided by the Playwright base image.
# The Ubuntu base ships /etc/apt/apt.conf.d/docker-clean, whose Post-Invoke hook
# forks a sub-shell to `rm` the apt cache after every update. On the constrained
# Jenkins build host that fork can fail to spawn, and apt aborts with exit 100 —
# even though `apt-get update` itself succeeded and the rm ends in `|| true`
# (apt treats the hook-execution failure as the error, not the rm's exit code).
# Removing docker-clean and clearing the hook list inline avoids that fork; we do
# our own cache cleanup at the end. NOTE: the underlying low process/thread limit
# on the build container is the real cause (see infra/cicd-utils) — this only
# makes the apt step resilient to it; it cannot raise the limit from a Dockerfile.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && APT_OPTS="-o APT::Update::Post-Invoke-Success::= -o APT::Update::Post-Invoke::= -o Dpkg::Post-Invoke::=" \
    && apt-get $APT_OPTS update \
    && apt-get $APT_OPTS install -y --no-install-recommends wget gnupg ca-certificates \
    && wget -qO- https://dl.google.com/linux/linux_signing_key.pub \
        | gpg --dearmor -o /usr/share/keyrings/google-chrome-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
        > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get $APT_OPTS update \
    && apt-get $APT_OPTS install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb

USER vcita
