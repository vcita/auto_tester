### .env.development file
## This file contains the environment variable suited for local development purposes only,
## it is gitignore and should not be in the source code repository.
##
## If you have environment variables (variables which changes based on runtime environment),
## you should add them to your `shipit.yml` file
##
## If you have variables which are used by some package but they are static (such as REDIS_QUEUES)
## you should also add them to your `shipit.yml` file in the helm_values.default.default_application.global.deployment.env object
## see also: https://myvcita.atlassian.net/wiki/spaces/IT/pages/2226029182/Creating+a+New+Microservice#Environment-variables
##
## Environment variables which are considered SECRETS (such as api keys or passwords)
## MUST NOT be written in plain text files, but go through Infra team procedures (as of 12.2021)

ENVIRONMENT=development
PORT=48475

### Application configurations
APP_NAME=autotester
SWAGGER_TAG=autotester

### Logging configuration
## Defines the minimum logging level to be outputted
LOG_LEVEL=verbose
## Defines the format of logs
LOG_FORMAT=human_readable

### Database configurations
## infra-nestjs 2.3.2 makes DATABASE_HOST redundant when developing
#DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_NAME=autotester

### Redis configurations
## infra-nestjs 2.3.2 makes REDIS_HOST redundant when developing
#REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_QUEUES=notes

### Sometimes you would need entities from other packages - add their path here
CUSTOM_ENTITIES=["/home/node_modules/@vcita/oauth-client-nestjs/dist/oauth/**/*.entity.js","./node_modules/@vcita/oauth-client-nestjs/dist/oauth/**/*.entity.js"]

### Oauth Params
## Use `vmake create-app autotester` to have this section auto generated
OAUTH_REDIRECT_URI=<oauth_redirect_uri>
OAUTH_CLIENT_SECRET=<oauth_client_secret>
OAUTH_CLIENT_ID=<oauth_client_id>
OAUTH_SERVER=http://app.dev-vcita.me:7200/app/oauth/authorize

## Servers
API_GW_SERVER=https://host.docker.internal:8243
AUTHORIZATION_SERVER=http://host.docker.internal:7100

