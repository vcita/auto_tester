{
  "name": "autotester",
  "private": true,
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "db:migrate": "npm run typeorm -- migration:run",
    "typeorm": "npm run ormconfig:gen && node --require ts-node/register /home/node_modules/typeorm/cli.js",
    "ormconfig:gen": "node --require ts-node/register /home/node_modules/@vcita/infra-nestjs/dist/infra/utils/ormconfig-gen.utils.js",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0 --watch",
    "start:prod": "node dist/src/main || node dist/main",
    "job:debug": "INFRA_DISABLE_BULL_METRIC=true nest start --debug 0.0.0.0 -c nest-cli.job.json --",
    "job:exec": "INFRA_DISABLE_BULL_METRIC=true node dist/src/jobs/job.main",
    "swaggerize": "PRE_COMPILED=true ENVIRONMENT=test NODE_ENV=test nest start",
    "lint": "eslint src test --ext ts -f checkstyle -o reports/eslint.xml",
    "lint:fix": "eslint src test --ext ts --fix",
    "test": "ENVIRONMENT=test NODE_ENV=test jest",
    "test:watch": "ENVIRONMENT=test NODE_ENV=test jest --watch",
    "test:cov": "ENVIRONMENT=test NODE_ENV=test jest --coverage",
    "test:debug": "ENVIRONMENT=test NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "ENVIRONMENT=test NODE_ENV=test jest --config ./jest-e2e.json",
    "test:e2e:watch": "ENVIRONMENT=test NODE_ENV=test jest --config ./test/jest-e2e.json --watchAll"
  },
  "dependencies": {
    "@nestjs/bull": "^0.3.1",
    "@nestjs/common": "^7.6.15",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.15",
    "@nestjs/microservices": "^7.6.15",
    "@nestjs/platform-express": "^7.6.15",
    "@nestjs/swagger": "^4.8.0",
    "@nestjs/terminus": "^7.2.0",
    "@nestjs/typeorm": "^7.1.5",
    "@vcita/infra-nestjs": "^2.24.1",
    "@vcita/oauth-client-nestjs": "^4.2.0",
    "@willsoto/nestjs-prometheus": "^3.0.0",
    "api-spec-converter": "^2.12.0",
    "bull": "^3.22.8",
    "bull-prom": "^3.2.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "dotenv": "^10.0.0",
    "joi": "^17.4.0",
    "mysql2": "^2.2.5",
    "nestjs-command": "^3.1.4",
    "nestjs-redis": "^1.3.3",
    "prom-client": "^13.1.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.6.6",
    "swagger-ui-express": "^4.1.6",
    "typeorm": "^0.2.32",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.6.0",
    "@types/uuid": "^10.0.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.15",
    "@types/bull": "^3.15.1",
    "@types/cron": "^1.7.2",
    "@types/express": "^4.17.11",
    "@types/ioredis": "^4.28.1",
    "@types/jest": "^29.5.12",
    "@types/joi": "^17.2.3",
    "@types/node": "^14.14.36",
    "@types/supertest": "^2.0.10",
    "@types/yargs": "^17.0.26",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "@vcita/eslint-config-nestjs": "^1.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "sqlite3": "^5.1.2",
    "supertest": "^6.1.3",
    "ts-jest": "^29.2.3",
    "ts-loader": "^8.0.18",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.2.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
