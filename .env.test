ENVIRONMENT=test
# Temporary place. Need it for CI/CD swaggerization
APP_NAME=autotester
SWAGGER_TAG=autotester

# In-memory DB
DATABASE_TYPE=sqlite
DATABASE_NAME=:memory:
SYNCHRONIZE=true

# For mocking queues purposes
REDIS_QUEUES=notes

# Incase oauth package is needed
CUSTOM_ENTITIES=["/home/node_modules/@vcita/oauth-client-nestjs/dist/oauth/**/*.entity.js","./node_modules/@vcita/oauth-client-nestjs/dist/oauth/**/*.entity.js"]
